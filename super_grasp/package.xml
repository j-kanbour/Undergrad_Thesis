<?xml version="1.0"?>
<package format="2">
  <name>super_grasp</name>
  <version>1.0.0</version>
  <description>The super_grasp package</description>

  <license>NA</license>

  <maintainer email="jkanbour1@gmail.com">Jayden Kanbour</maintainer>
  <author email="jkanbour1@gmail.com">Jayden Kanbour</author>

  <!-- Build tool -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Build & runtime deps (match CMakeLists.txt and your imports) -->
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>unsw_vision_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>unsw_vision_msgs</exec_depend>

  <!-- If hsrb_interface is available as a ROS package on your robot, keep this. 
       If it’s just a pip/robot-specific Python module, you can remove it. -->
  <exec_depend>hsrb_interface</exec_depend>

  <export/>
</package>
